{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MicDeck",
  "version": "0.1.24",
  "identifier": "local.micdeck",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MicDeck",
        "visible": false,
        "width": 1240,
        "height": 780,
        "minWidth": 860,
        "minHeight": 620,
        "backgroundColor": "#090b0d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm",
      "deb",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "Zeigt, ob dein DJI Mic Mini verbunden ist und Ton ankommt.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "rpm": {
        "depends": [
          "pipewire-libs",
          "webkit2gtk4.1",
          "gtk3"
        ],
        "files": {
          "/usr/lib/udev/rules.d/70-micdeck.rules": "../../packaging/70-micdeck.rules"
        },
        "postInstallScript": "../../packaging/rpm-post.sh",
        "postRemoveScript": "../../packaging/rpm-post.sh"
      }
    },
    "license": "MIT OR Apache-2.0",
    "licenseFile": "../../LICENSE-MIT"
  }
}
